generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["collaboration"]
}

model Team {
  id        String             @id @db.Uuid
  name      String             @db.VarChar(80)
  createdBy String             @map("created_by")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  members   TeamMember[]
  invites   TeamInvitation[]
  boards    TaskBoard[]

  @@map("teams")
  @@schema("collaboration")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id")
  role      String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId, teamId], map: "team_members_user_idx")
  @@map("team_members")
  @@schema("collaboration")
}

model TeamInvitation {
  id        String   @id @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  email     String   @db.VarChar(254)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  invitedBy String   @map("invited_by")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@map("team_invitations")
  @@schema("collaboration")
}

model TaskBoard {
  id        String     @id @db.Uuid
  teamId    String     @map("team_id") @db.Uuid
  title     String     @db.VarChar(120)
  createdBy String     @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lists     TaskList[]

  @@index([teamId, createdAt(sort: Desc)], map: "task_boards_team_idx")
  @@map("task_boards")
  @@schema("collaboration")
}

model TaskList {
  id        String     @id @db.Uuid
  boardId   String     @map("board_id") @db.Uuid
  title     String     @db.VarChar(80)
  position  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  board     TaskBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     TaskCard[]

  @@index([boardId, position], map: "task_lists_board_idx")
  @@map("task_lists")
  @@schema("collaboration")
}

model TaskCard {
  id          String    @id @db.Uuid
  listId      String    @map("list_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String    @default("")
  position    Int       @default(0)
  assigneeId  String?   @map("assignee_id")
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  list        TaskList  @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, position, createdAt], map: "task_cards_list_idx")
  @@map("task_cards")
  @@schema("collaboration")
}
