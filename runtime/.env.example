# Paste these into Dokploy > Environment (or copy to .env for local `docker compose up`).

# --- Required secrets (generate each one separately) ---
POSTGRES_PASSWORD=                # openssl rand -hex 24
BETTER_AUTH_SECRET=               # openssl rand -base64 48
FLOQ_ENCRYPTION_KEY=              # openssl rand -hex 32 (encrypts API keys / GitHub tokens at rest; if changed, stored credentials become unreadable)
BETTER_AUTH_URL=https://runtime.example.com   # public https URL of this service

# --- Accounts ---
# Signup is closed by default. The admin whose email is set below claims the account in the app with the setup token (see below).
FLOQ_ALLOW_SIGNUP=0
# The admin claims this account in the app with a one-time setup token that the runtime prints once to its logs ("FLOQ SETUP TOKEN") on first start.
FLOQ_BOOTSTRAP_ADMIN_EMAIL=

# --- GitHub device-flow login ---
# Create a GitHub OAuth App, tick "Enable Device Flow", paste its Client ID.
# Defaults to the GitHub CLI's public client id; set your own OAuth App (Device Flow enabled) to override.
GITHUB_CLIENT_ID=

# --- Optional ---
# Co-author trailer added to commits made in Floq sessions (users can switch it off). Empty disables it for everyone.
# FLOQ_GIT_COAUTHOR=floqless <floq@flowless.app>
# Explicit origins of the Floq client ('*' is rejected).
FLOQ_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
# Where outside services reach this runtime (plugin webhooks, e.g. WAHA). Default: BETTER_AUTH_URL unless that is a loopback address.
# FLOQ_PUBLIC_URL=https://floq.example.com
FLOQ_SESSION_IDLE_TIMEOUT_MS=300000
FLOQ_SESSION_MAX_LIFETIME_MS=3600000
FLOQ_LOG_LEVEL=info
FLOQ_MEM_LIMIT=8g
# Where decrypted user homes are mounted inside the container (default /mnt/floq; must be under /mnt, /media, /tmp or $HOME on Ubuntu >= 25.04 hosts).
# FLOQ_MOUNT_ROOT=/mnt/floq
# Preinstalled third-party skills (the image bundle) are seeded into user homes and listed only when this is 1 (default 0).
# Floq's own floq-orchestrate and floq-vault skills are always seeded and cannot be deleted. Turning this off never removes skills already in a home.
PREINSTALL_SKILLS=1
# Selectable models per provider as id:label,id:label (the session model picker; "Default" is always added).
# FLOQ_CLAUDE_MODELS=opus:Opus,sonnet:Sonnet,haiku:Haiku
# FLOQ_CODEX_MODELS=gpt-5.5:GPT-5.5,gpt-5.4:GPT-5.4

# --- Enable agent memory (optional) ---
# Memory is off while FLOQ_REDIS_URL is empty. To turn it on with the bundled store (DragonflyDB), set these in .env:
#   COMPOSE_PROFILES=memory
#   FLOQ_REDIS_PASSWORD=<openssl rand -hex 24>      (the store refuses to start without it: agent sandboxes share the network)
#   FLOQ_REDIS_URL=redis://:<the same password>@dragonfly:6379
# then `docker compose up -d`. Alternative store: Redis 8+ with the Query Engine (COMPOSE_PROFILES=memory-redis,
# FLOQ_REDIS_URL=redis://:<password>@redis:6379). Your own server works too (needs search: Redis 8+ or Dragonfly); the password
# goes in the URL and is never logged. Existing "memory" notes are imported automatically the first time memory starts.
FLOQ_REDIS_PASSWORD=
FLOQ_REDIS_URL=
# Semantic search: local (default; downloads the model on first use), openai (needs OPENAI_API_KEY), off (full-text only; use it under ~4 GB RAM).
FLOQ_EMBEDDINGS=local
# Local model. Default: IBM Granite embedding 311M multilingual r2 (q8, 768d cut to 384; ~347 MB download, ~+620 MB RAM).
# Smaller alternative: FLOQ_EMBEDDINGS_MODEL=Xenova/multilingual-e5-small (~135 MB, ~+460 MB RAM, lower quality).
# Changing model, dtype or dims re-embeds every memory in the background; search stays full-text until that finishes.
FLOQ_EMBEDDINGS_MODEL=
FLOQ_EMBEDDINGS_DIMS=
# onnxruntime threads (default 4) and precision (q8 | fp32; empty = the model's default, q8 for Granite and e5).
FLOQ_EMBEDDINGS_THREADS=4
FLOQ_EMBEDDINGS_DTYPE=
OPENAI_API_KEY=

# --- Built-in WhatsApp server (on by default) ---
# WAHA Core (Apache-2.0, https://github.com/devlikeapro/waha) runs as its own container next to the runtime with no setup: the
# runtime creates its API key once (volume wahakey), points the WhatsApp integration at it, registers the webhook and keeps it
# updated; you only scan the QR code. WhatsApp is linked through an unofficial client; numbers that send spam or bulk messages can be banned.
# Optional: your own key (at least 24 characters; written to the shared key file for WAHA).
# FLOQ_WHATSAPP_API_KEY=<openssl rand -hex 32>
# Image tag (the floor; Floq updates to newer stable releases by itself). ARM hosts: noweb-arm-2026.10.1
# FLOQ_WHATSAPP_IMAGE_TAG=noweb-2026.10.1
# FLOQ_WHATSAPP_MEM_LIMIT=1g
# FLOQ_WHATSAPP_CPUS=1.0
# FLOQ_WHATSAPP_BUILTIN=0     # do not use the built-in server (also stop it: docker compose stop waha)
