{
  "name": "floq-runtime",
  "private": true,
  "version": "1.0.59",
  "description": "Self-hosted runtime for Floq: hosts Claude Code and Codex agent sessions in sandboxed per-user terminals",
  "author": "Victor Lima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorl1m/Floq.git",
    "directory": "runtime"
  },
  "homepage": "https://github.com/victorl1m/Floq#readme",
  "bugs": {
    "url": "https://github.com/victorl1m/Floq/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "self-hosted",
    "pty",
    "sandbox",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && tsc -p tsconfig.image.json && node scripts/copy-plugin-assets.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.mts && npm run test:whatsapp",
    "prisma:deploy": "prisma migrate deploy",
    "start": "prisma migrate deploy && node dist/index.js",
    "dev": "prisma migrate deploy && tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.image.json --noEmit",
    "test:whatsapp": "node --test --test-concurrency=2 --test-timeout=300000 test/whatsapp/*.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-auth": "^1.7.18",
    "node-pty": "^1.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.0.0",
    "redis": "^6.3.1",
    "smol-toml": "^1.9.1",
    "ws": "^8.18.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.12",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
