import test from 'node:test';
import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { createServer } from 'node:http';

const hook = new URL('../image/floq-native-question.mts',import.meta.url).pathname;
const payload={tool_name:'AskUserQuestion',tool_use_id:'tool-1',tool_input:{questions:[{question:'Which?',header:'Choice',options:[{label:'A',description:'First'},{label:'B',description:'Second'}],multiSelect:false}]}};
function run(url:string,input:unknown=payload) { return new Promise<{code:number|null;out:string}>((resolve)=>{const c=spawn(process.execPath,['--import','tsx',hook],{env:{...process.env,FLOQ_API_URL:url,FLOQ_AGENT_TOKEN:'test'}});let out='';c.stdout.on('data',d=>out+=d);c.on('close',code=>resolve({code,out}));c.stdin.end(JSON.stringify(input));}); }
test('hook returns provider updatedInput with original questions and selected labels',async t=>{let sent:any;const server=createServer(async(req,res)=>{let s='';for await(const d of req)s+=d;const body=JSON.parse(s);if(req.url?.endsWith('/native-request')) {sent=body;res.end(JSON.stringify({id:'d',decision:{status:'pending'}}));}else res.end(JSON.stringify({status:'answered',response:{answers:[{questionId:'q0',optionIds:['o1'],text:''}]}}));});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));t.after(()=>server.close());const addr=server.address() as any;const result=await run(`http://127.0.0.1:${addr.port}`);assert.equal(result.code,0);assert.equal(sent.providerRequestId,'tool-1');const update=JSON.parse(result.out).hookSpecificOutput.updatedInput;assert.deepEqual(update.questions,payload.tool_input.questions);assert.deepEqual(update.answers,{'Which?':'B'});});
test('hook falls back silently offline or for malformed or ambiguous payload',async()=>{for(const input of [payload,{}, {...payload,tool_input:{questions:[payload.tool_input.questions[0],payload.tool_input.questions[0]]}}]){const result=await run('http://127.0.0.1:1',input);assert.equal(result.code,0);assert.equal(result.out,'');}});
test('terminal fallback returns no hook override',async t=>{const server=createServer(async(req,res)=>{for await(const _ of req){} if(req.url?.endsWith('/native-request'))res.end(JSON.stringify({id:'d',decision:{status:'pending'}}));else res.end(JSON.stringify({status:'cancelled'}));});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));t.after(()=>server.close());const addr=server.address() as any;const result=await run(`http://127.0.0.1:${addr.port}`);assert.equal(result.code,0);assert.equal(result.out,'');});
test('a stalled runtime request times out and falls back silently',async t=>{const server=createServer(()=>{});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));t.after(()=>{server.closeAllConnections();server.close();});const addr=server.address() as any;const result=await run(`http://127.0.0.1:${addr.port}`);assert.equal(result.code,0);assert.equal(result.out,'');});
